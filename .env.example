# Copie para .env (local). No Render, defina as mesmas chaves no painel Environment.
# Nunca commite .env com segredos reais.

# --- Obrigatório em produção (Render + PostgreSQL) ---
# No Render: Postgres → aba External → External Database URL (cole aqui, sem commitar).
# Opcional no final da URL: ?sslmode=require (o app também força TLS para hosts remotos).
DATABASE_URL=<EXTERNAL_RENDER_DATABASE_URL>
SECRET_KEY=

# No Render: recomendado (generateValue no blueprint). Se vazio, o app sobe, mas importação
# para datas diferentes de hoje fica bloqueada (ver render_env_validation / logs).
IMPORT_AUTH_PASSWORD=

# Admin inicial (bootstrap)
ADMIN_EMAIL=
ADMIN_PASS=
# Opcional: papel do admin (padrão: admin)
# ADMIN_ROLE=admin

# URL pública do app (links em e-mail, OAuth callback, cookies seguros em HTTPS)
APP_BASE_URL=https://seu-servico.onrender.com

# --- Banco: comportamento ---
# true = mais tentativas ao conectar ao Postgres na subida (recomendado no Render)
REQUIRE_RENDER_DB=true
# true = força SQLite local mesmo com DATABASE_URL (só desenvolvimento)
# FORCE_LOCAL_DB=false

# --- Opcional: diagnóstico ---
# DEBUG=false
# ENV=production
# ENVIRONMENT=production
# DB_POOL_SIZE=8
# DB_MAX_OVERFLOW=12
# DB_CONNECT_TIMEOUT=12
# DB_PROBE_TIMEOUT=15

# --- E-mail (SMTP) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_TLS=true
# SMTP_USE_SSL=false
# MAINTENANCE_EMAIL_TO=
# MAINTENANCE_EMAIL_FROM=

# --- Google OAuth (opcional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- Google Gemini (opcional) ---
# GEMINI_API_KEY=

# --- Importação / API ---
# Troque o padrão fraco em produção.
# IMPORT_AUTH_PASSWORD=

# --- Sessão / proxy ---
# Render define RENDER=true automaticamente (também ativa pool maior e proxy headers).
# TRUST_PROXY_HEADERS=true

# --- WhatsApp (envio de avisos de rota / separação) ---
# mock = simula envio (padrão). meta_cloud = Meta Cloud API.
# WHATSAPP_PROVIDER_MODE=mock
# WHATSAPP_PROVIDER_MODE=meta_cloud
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Opcional: WHATSAPP_CLOUD_API_VERSION=21.0
# Template aprovado na Meta (avisos fora da janela de 24h costumam exigir template):
# WHATSAPP_CLOUD_TEMPLATE_NAME=
# WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=pt_BR
# 0 = template sem variável no corpo; 1 = uma variável (texto do aviso)
# WHATSAPP_CLOUD_TEMPLATE_BODY_VARS=1
# Alias: META_WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID
# Mock: sufixos de telefone que falham (testes): WHATSAPP_MOCK_FAIL_SUFFIXES=0000,9999

# --- n8n (webhook opcional para automações pós-envio de WhatsApp em rota) ---
# URL do webhook "Production URL" do fluxo n8n.
# N8N_DELIVERY_WHATSAPP_WEBHOOK_URL=https://seu-subdominio.app.n8n.cloud/webhook/...
# Token opcional: enviado em Authorization: Bearer <token>
# N8N_DELIVERY_WHATSAPP_WEBHOOK_AUTH_TOKEN=
# Timeout em segundos para chamada do webhook (2 a 60, padrão 10)
# N8N_DELIVERY_WHATSAPP_WEBHOOK_TIMEOUT_SECONDS=10
