# EditorConfig - Garante UTF-8 e consistência em todo o projeto
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,html,js,ts,vue,css,json,md,yml,yaml,toml}]
charset = utf-8
indent_style = space
indent_size = 4

[*.{html,js,ts,vue,css,json}]
indent_size = 2
